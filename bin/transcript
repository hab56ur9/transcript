#!/bin/bash
set -euo pipefail

REPO="hab56ur9/transcript"
STABLE_APP="$HOME/Applications/Transcript.app"
STABLE_PATTERN="Transcript.app/Contents/MacOS/Transcript"
DEV_PATTERN="TranscriptDev.app/Contents/MacOS/Transcript"
SUPPORT="$HOME/Library/Application Support/Transcript"
STATE="$SUPPORT/state.json"

migrate_legacy() {
  if [ -d "$HOME/Documents/VoiceScribe" ] && [ ! -e "$HOME/Documents/Transcript" ]
  then
    mv "$HOME/Documents/VoiceScribe" "$HOME/Documents/Transcript"
  fi
  if [ -d "$HOME/Library/Application Support/VoiceScribe" ] && [ ! -e "$SUPPORT" ]
  then
    mv "$HOME/Library/Application Support/VoiceScribe" "$SUPPORT"
  fi
}

recording_active() {
  grep -qE '"status":"(recording|paused)"' "$STATE" 2>/dev/null
}

running_pattern() {
  if pgrep -f "$STABLE_PATTERN" > /dev/null
  then
    echo "$STABLE_PATTERN"
    return 0
  fi
  if pgrep -f "$DEV_PATTERN" > /dev/null
  then
    echo "$DEV_PATTERN"
    return 0
  fi
  return 1
}

signal_running() {
  local sig="$1" pattern
  if ! pattern="$(running_pattern)"
  then
    echo "실행 중인 Transcript가 없습니다."
    exit 1
  fi
  pkill "-$sig" -f "$pattern"
  exit 0
}

watch_mode() {
  for _ in $(seq 1 150)
  do
    if recording_active
    then
      break
    fi
    sleep 2
  done
  while recording_active
  do
    sleep 2
  done
  cat "$STATE" 2>/dev/null || true
  exit 0
}

latest_zip_url() {
  curl -fsSL "https://api.github.com/repos/$REPO/releases" 2>/dev/null |
    grep -o 'https://[^"]*/Transcript\.app\.zip' | head -1 || true
}

install_stable() {
  echo "Transcript 최신 릴리즈 설치 중..."
  local url tmp
  url="$(latest_zip_url)"
  if [ -z "$url" ]
  then
    echo "다운로드할 릴리즈를 찾지 못했습니다: https://github.com/$REPO/releases"
    exit 1
  fi
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/Transcript.app.zip" "$url"
  mkdir -p "$HOME/Applications"
  rm -rf "$STABLE_APP"
  ditto -xk "$tmp/Transcript.app.zip" "$HOME/Applications"
  xattr -dr com.apple.quarantine "$STABLE_APP" 2>/dev/null || true
  rm -rf "$tmp"
  echo "설치됨: $STABLE_APP"
}

is_backfill() {
  printf '%s\n' "$@" | grep -q -- "--backfill"
}

is_record() {
  printf '%s\n' "$@" | grep -q -- "--record"
}

launch() {
  local app="$1" pattern="$2" other="$3"
  shift 3
  if pgrep -f "$other" > /dev/null
  then
    echo "다른 트랙의 Transcript가 실행 중입니다. 상태 파일이 충돌하니 먼저 종료해주세요: transcript quit"
    exit 1
  fi
  if pgrep -f "$pattern" > /dev/null
  then
    if is_record "$@"
    then
      pkill -USR1 -f "$pattern"
      exit 0
    fi
    echo "Transcript이 이미 실행 중입니다."
    exit 0
  fi
  if [ $# -gt 0 ]
  then
    exec open "$app" --args "$@"
  fi
  exec open "$app"
}

run_dev() {
  local root="$1"
  shift
  source "$root/bin/bundle-lib.sh"
  local bin="$root/.build/release/Transcript"
  local app="$root/.build/TranscriptDev.app"
  local app_bin="$app/Contents/MacOS/Transcript"
  if [ ! -x "$bin" ] || [ -n "$(find "$root/Sources" "$root/Package.swift" -newer "$bin" 2>/dev/null | head -1)" ]
  then
    echo "Transcript 빌드 중 (dev)..."
    swift build -c release --package-path "$root"
  fi
  if [ ! -x "$app_bin" ] || [ "$bin" -nt "$app_bin" ]
  then
    assemble_app "$app" "com.nathan.transcript.dev" "TranscriptDev" "$root"
  fi
  if is_backfill "$@"
  then
    exec "$app_bin" "$@"
  fi
  launch "$app" "$DEV_PATTERN" "$STABLE_PATTERN" "$@"
}

run_stable() {
  if [ ! -x "$STABLE_APP/Contents/MacOS/Transcript" ]
  then
    install_stable
  fi
  if is_backfill "$@"
  then
    exec "$STABLE_APP/Contents/MacOS/Transcript" "$@"
  fi
  launch "$STABLE_APP" "$STABLE_PATTERN" "$DEV_PATTERN" "$@"
}

migrate_legacy

if [ "${1:-}" = "--watch" ]
then
  watch_mode
fi

if [ "${1:-}" = "start" ]
then
  if running_pattern > /dev/null
  then
    signal_running USR1
  fi
  set -- --record
fi

if [ "${1:-}" = "stop" ]
then
  signal_running USR2
fi

if [ "${1:-}" = "quit" ]
then
  signal_running TERM
fi

update_cli() {
  local self root tmp
  self="$(readlink -f "$0")"
  root="$(cd "$(dirname "$self")/.." && pwd)"
  if [ -f "$root/Package.swift" ]
  then
    return 0
  fi
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/transcript" "https://raw.githubusercontent.com/$REPO/main/bin/transcript"
  chmod +x "$tmp/transcript"
  mv "$tmp/transcript" "$self"
  rmdir "$tmp"
  echo "CLI 업데이트됨: $self"
}

if [ "${1:-}" = "update" ] || [ "${1:-}" = "--install" ]
then
  install_stable
  update_cli
  exit 0
fi

SELF_ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

if [ -f "$SELF_ROOT/Package.swift" ] && [ -d "$SELF_ROOT/Sources/Transcript" ]
then
  run_dev "$SELF_ROOT" "$@"
fi

run_stable "$@"
